{
  "name": "@angry-pixel-skeleton/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Electron shell for Angry Pixel multiplatform skeleton",
  "author": "Angry Pixel",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64"
  },
  "build": {
    "electronVersion": "45.2.1",
    "appId": "com.angrypixel.multiplatform.skeleton",
    "productName": "AngryPixelSkeleton",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.cjs",
      "package.json",
      "build/icon.png",
      {
        "from": "../browser/dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "executableName": "angry-pixel-skeleton",
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "26.15.3"
  }
}
